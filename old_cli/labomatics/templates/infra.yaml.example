version: "v1"

openwrt:
  vmid_start: 10000          # VMID = vmid_start + student.id
  template_vmid: 90200       # VMID de la template OpenWrt (stockage partagé requis)
  storage: zfs-store         # Stockage partagé accessible depuis tous les nœuds
  wan_bridge: vmbr0          # Bridge WAN sur les nœuds Proxmox
  students_csv: students.csv # Chemin vers le CSV étudiants (relatif à ce fichier)
  template_pool: template    # Pool Proxmox contenant les templates (accès étudiants)

  network:
    zone_name: esgilab       # Nom de la zone SDN VXLAN (doit exister dans Proxmox)

    wan_pool:
      network: 172.16.0.0/24
      gateway: 172.16.0.254
      exclude:
        - "172.16.0.1-172.16.0.10"   # IPs réservées infrastructure

    vxlan_pool:
      network: 10.100.0.0/12         # Pool de subnets /24 — un par étudiant
      exclude: []

# Profils de ressources (flavors)
# cpu: vCPU max running, ram: MB max running, disk: GB max total
# Valeur 0 = illimité
flavors:
  CO1:
    cpu: 4
    ram: 8192     # 8 GB
    disk: 40      # 40 GB
  CO2:
    cpu: 8
    ram: 16384    # 16 GB
    disk: 80      # 80 GB
  unlimited:
    cpu: 0
    ram: 0
    disk: 0

# Daemon de surveillance des quotas
quotad:
  interval: 30    # secondes entre chaque vérification
  action: stop    # "stop" (arrêt auto) ou "alert-only" (logs seulement)

# Templates personnalisées (optionnel)
# Construites avec : labomatics build-template [nom1,nom2 | *]
#
# default_user / default_pass : credentials cloud-init pré-remplis dans toutes les templates
#   → visibles dans l'onglet Cloud-Init lors de la création d'un clone
#   → surchargeables par template via cloud_init_user / cloud_init_password
#
# default_packages : liste de packages installés dans TOUTES les templates via virt-customize
#   → exécuté en SSH sur le nœud Proxmox avant la création de la VM
#   → libguestfs-tools auto-installé sur le nœud si absent
#   → désactiver pour une template spécifique avec : download_packages: false
#
# extra_packages  : packages supplémentaires pour une template spécifique (s'ajoutent à default_packages)
# download_packages: false → désactive virt-customize pour cette template
#
# cloudinit: false  → import direct sans boot (ex: OPNsense) — pas de drive cloud-init
# iso_filename      → utile si l'URL pointe vers une archive (.bz2/.gz) ou un .img
#                     (renommer en .qcow2 ou .raw pour satisfaire l'API Proxmox)
templates:
  default_user: labomatics          # utilisateur cloud-init par défaut
  default_pass: changeme            # mot de passe cloud-init par défaut (à changer !)

  # ⚠  Ne pas supprimer ni modifier - requis pour la détection de fin de boot,
  #    le summary Proxmox et l'arrêt propre des VMs.
  #    Ajoutez des packages supplémentaires par template via extra_packages.
  default_packages:
    - qemu-guest-agent

  sources:
    - name: ubuntu-25.10
      vmid: 90100
      storage_pool: local-lvm
      iso_storage_pool: local
      iso_url: "https://cloud-images.ubuntu.com/releases/questing/release/ubuntu-25.10-server-cloudimg-amd64.img"
      iso_filename: "ubuntu-25.10-server-cloudimg-amd64.qcow2"  # .img → .qcow2 requis par l'API Proxmox
      memory: 2048
      cores: 2
      disk_size: "10G"

    - name: debian-13
      vmid: 90101
      storage_pool: local-lvm
      iso_storage_pool: local
      iso_url: "https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2"
      memory: 2048
      cores: 2
      disk_size: "10G"

    - name: fedora-43
      vmid: 90102
      storage_pool: local-lvm
      iso_storage_pool: local
      iso_url: "https://download.fedoraproject.org/pub/fedora/linux/releases/43/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-43-1.6.x86_64.qcow2"
      memory: 2048
      cores: 2
      disk_size: "10G"

    - name: alpine-3
      vmid: 90103
      storage_pool: local-lvm
      iso_storage_pool: local
      iso_url: "https://dl-cdn.alpinelinux.org/alpine/v3.21/releases/cloud/nocloud_alpine-3.21.0-x86_64-bios-cloudinit-r0.qcow2"
      memory: 512
      cores: 1
      disk_size: "10G"
      cpu_type: "kvm64"      # x86-64-v2-AES peut causer des problèmes avec Alpine
      boot_timeout: 100      # Alpine va timeout une premiere fois re démarer et tout sera OK

    - name: opnsense-25
      vmid: 90110
      storage_pool: local-lvm
      iso_storage_pool: local
      iso_url: "https://mirror.ams1.nl.leaseweb.net/opnsense/releases/25.1/OPNsense-25.1-nano-amd64.img.bz2"
      iso_filename: "OPNsense-25.1-nano-amd64.raw"  # Proxmox décompresse le .bz2 ; .raw = format réel
      cloudinit: false              # OPNsense est FreeBSD — pas de cloud-init
      ostype: other
      memory: 8164
      cores: 4
      disk_size: "30G"
      download_packages: false   # FreeBSD — virt-customize non applicable
