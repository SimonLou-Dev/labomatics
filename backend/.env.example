# Timezone
TIMEZONE=Europe/Paris

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=labomatics
DATABASE_PASSWORD=labomatics
DATABASE_NAME=labomatics

# Redis
REDIS_URL=redis://redis:6379/0

# Keycloak
KEYCLOAK_URL=http://keycloak:8080/
KEYCLOAK_REALM=labomatics
KEYCLOAK_CLIENT_ID=labomatics
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-password

# Security
ENCRYPTION_KEY=changeme-super-secret-key-32bytes

# App
APP_URL=http://localhost:8000
URL_PREFIX=/api

# Cluster Config
# CLUSTER_CONFIG_PATH=/etc/labomatics/clusterconfig.yaml

# SMTP (optionnel pour Keycloak)
# Si configuré, Keycloak utilisera ce serveur SMTP pour envoyer les emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=password
SMTP_TLS=true

# Brevo API (pour l'envoi de mails depuis le backend)
BREVO_API_KEY=your-brevo-api-key-here
# BREVO_FROM_EMAIL doit être validé dans Brevo. Utilise la même adresse que SMTP_USER
BREVO_FROM_EMAIL=noreply@example.com
# BREVO_FROM_NAME=Labomatics
