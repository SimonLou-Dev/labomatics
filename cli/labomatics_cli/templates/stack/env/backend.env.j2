# Timezone
TIMEZONE={{ timezone }}

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=labomatics
DATABASE_PASSWORD={{ secrets.labomatics_db_password }}
DATABASE_NAME=labomatics

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# Keycloak
KEYCLOAK_URL=https://keycloak.{{ domain }}
KEYCLOAK_REALM=labomatics
KEYCLOAK_CLIENT_ID=labomatics
KEYCLOAK_CLIENT_SECRET={{ secrets.keycloak_client_secret or "" }}
KEYCLOAK_ADMIN_USERNAME=labomatics-admin
KEYCLOAK_ADMIN_PASSWORD={{ secrets.labomatics_admin_password }}

# Security
ENCRYPTION_KEY={{ secrets.encryption_key }}

# App
APP_URL=https://api.labomatics.{{ domain }}
URL_PREFIX=/
FRONT_URL=https://labomatics.{{ domain }}

# Brevo API (envoi de mails du backend)
BREVO_API_KEY={{ mail.brevo_api_key }}
BREVO_FROM_EMAIL={{ mail.from_email }}
BREVO_FROM_NAME={{ mail.from_name }}

# SMTP
SMTP_HOST={{ mail.smtp_host }}
SMTP_PORT={{ mail.smtp_port }}
SMTP_USER={{ mail.smtp_user }}
SMTP_PASSWORD={{ mail.smtp_password }}
SMTP_STARTTLS={{ "true" if mail.smtp_starttls else "false" }}

CLUSTER_CONFIG_PATH=/etc/labomatics/clusterconfig.yaml
