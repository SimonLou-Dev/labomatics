# Timezone
TIMEZONE=Europe/Paris

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER={{ pg_user }}
DATABASE_PASSWORD={{ pg_password }}
DATABASE_NAME=labomatics

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# Keycloak
KEYCLOAK_URL=https://keycloak.{{ domain }}
KEYCLOAK_REALM=labomatics
KEYCLOAK_CLIENT_ID=labomatics
KEYCLOAK_CLIENT_SECRET={{ kc_client_secret }}
KEYCLOAK_ADMIN_USERNAME=labomatics-admin
KEYCLOAK_ADMIN_PASSWORD={{ kc_admin_password }}

# Security
ENCRYPTION_KEY={{ encryption_key }}

# App
APP_URL=https://api.labomatics.{{ domain }}
URL_PREFIX=/
FRONT_URL=https://labomatics.{{ domain }}

CLUSTER_CONFIG_PATH=/etc/labomatics/clusterconfig.yaml